# Azure Integration Test Environment Variables - EXAMPLE
# 
# This file shows the environment variables that will be automatically
# generated by the Azure deployment script. 
#
# DO NOT EDIT THIS FILE - it's just an example!
# 
# The actual .env.azure file is created by running:
#   make azure-deploy
# 
# Load the generated variables before running integration tests:
#   source tests/integration/infrastructure/azure/.env.azure
#

# Azure Storage Account (auto-generated unique name)
export AZURE_STORAGE_ACCOUNT="stactest12345678"

# Container name for test data
export AZURE_TEST_CONTAINER="test-data"

# SAS token for authentication (expires after 30 days)
export AZURE_SAS_TOKEN="sv=2022-11-02&ss=b&srt=co&sp=r&se=2024-12-31T23:59:59Z&st=2024-01-01T00:00:00Z&spr=https&sig=EXAMPLE_SIGNATURE"

# Managed Identity for authentication testing
export AZURE_CLIENT_ID="12345678-1234-1234-1234-123456789abc"

# Azure tenant and subscription information
export AZURE_TENANT_ID="87654321-4321-4321-4321-cba987654321"
export AZURE_SUBSCRIPTION_ID="abcdef12-3456-7890-abcd-ef1234567890"

# Resource group information (for cleanup)
export AZURE_RESOURCE_GROUP="stac-fastapi-duckdb-test"

# Additional variables for reference
export AZURE_RESOURCE_GROUP_NAME="stac-fastapi-duckdb-test"
export AZURE_LOCATION="eastus2"
export AZURE_ENVIRONMENT_NAME="test"

# Usage Examples:
# 
# 1. Deploy Azure infrastructure:
#    make azure-deploy
# 
# 2. Load environment variables:
#    source tests/integration/infrastructure/azure/.env.azure
# 
# 3. Run integration tests:
#    make test-azure-integration
#    # OR
#    pytest tests/integration/test_azure_integration.py -v -m integration
# 
# 4. Clean up Azure resources:
#    make azure-teardown